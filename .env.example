# Copy to .env and fill in. .env is gitignored — never commit real values.
#
# In a deployment these come from the orchestrator's own configuration and the
# secrets manager, not from a file: the non-secret values below are plain env
# vars, and OPENAI_API_KEY is injected from the secrets manager at start
# (spec/09-implementation-notes.md §13, §16).

# --- Metadata DB (02 §3) ---
KARPWIKI_DATABASE_URL=postgresql+asyncpg://karpwiki:karpwiki@localhost:5432/karpwiki
KARPWIKI_TEST_DATABASE_URL=postgresql+asyncpg://karpwiki:karpwiki@localhost:5432/karpwiki_test

# --- Object Store (02 §2) — fsspec URL ---
# Local default is the MinIO service in docker-compose, backed by the `objectstore`
# named volume: the raw sources here are immutable originals nothing can regenerate, and
# this exercises the same s3:// code path a deployment uses.
KARPWIKI_OBJECT_STORE_URL=s3://karpwiki/objectstore
AWS_ACCESS_KEY_ID=karpwiki
AWS_SECRET_ACCESS_KEY=karpwiki-dev-secret
AWS_ENDPOINT_URL=http://localhost:9000
# Fallback with no MinIO: KARPWIKI_OBJECT_STORE_URL=file://./var/objectstore
# A relative file:// path resolves against each process's working directory, so it works
# only in a single-process checkout. Every deployed process group (gateway, services,
# workers — 06 §5) must share the SAME absolute path or s3:// URL, or a worker will not
# find the diffs the Wiki Service wrote.

# --- Async layer (01 §1) ---
KARPWIKI_CELERY_BROKER_URL=redis://localhost:6379/0
# Celery's Redis transport only redelivers an unacked message after this elapses (default
# 3600s is far too slow, found live via a kill-and-restart check, 09 §36).
KARPWIKI_CELERY_VISIBILITY_TIMEOUT_SECONDS=600

# --- Dedicated Full-Text Index backend (02 §4, 08 §2) ---
# Only used by a workspace with dedicated_index=True; every other workspace stays on the
# shared PostgreSQL full-text index. The docker-compose `opensearch` service runs with its
# security plugin disabled — a local dev/test convenience, not a deployment recommendation.
KARPWIKI_OPENSEARCH_URL=http://localhost:9200
# One shared index holds every dedicated workspace's pages — a deployment sharing one
# OpenSearch cluster across multiple karpwiki environments needs a distinct name per
# environment to avoid collision.
KARPWIKI_OPENSEARCH_INDEX_NAME=karpwiki-pages

# --- LLM (09 §16) — one Pydantic AI provider:model string per agent role ---
KARPWIKI_LLM_CLASSIFIER_MODEL=openai:gpt-5-nano
KARPWIKI_LLM_CURATOR_MODEL=openai:gpt-5-nano
# Retry/backoff for the three real LLM calls (03 §1 requires it, names no specific
# count/delay) — doubling from the base delay, capping a stuck call rather than blocking a
# worker slot forever.
KARPWIKI_LLM_RETRY_ATTEMPTS=3
KARPWIKI_LLM_RETRY_BASE_DELAY_SECONDS=1.0

# --- Maintenance Advisor scheduling (05 §2, phase2-tasklist.md step 41) ---
# Deployment-wide cadence for the celery-beat-fired detector sweeps, in hours. The
# Contradiction Detector spends a real LLM call per candidate (step 40), so it defaults to
# a slower cadence than the other four (no LLM cost at detection).
KARPWIKI_MAINTENANCE_INTERVAL_HOURS=24
KARPWIKI_MAINTENANCE_CONTRADICTION_INTERVAL_HOURS=168
# Staleness popularity tiering (05 §2's "scheduling philosophy", 09 §6's SCHEMA.md
# high_traffic_days/low_traffic_days illustrative defaults) — a page queried at least once
# in the last KARPWIKI_STALENESS_HIGH_TRAFFIC_DAYS is checked against that shorter bar;
# otherwise it needs KARPWIKI_STALENESS_LOW_TRAFFIC_DAYS to be flagged stale.
KARPWIKI_STALENESS_HIGH_TRAFFIC_DAYS=90
KARPWIKI_STALENESS_LOW_TRAFFIC_DAYS=365

# --- Connector polling dispatch (09 §4, phase2-tasklist.md step 52) ---
# How often celery-beat wakes up to check which *enabled* connectors are due, in minutes —
# not a per-connector setting (that's each Connector.schedule's own interval_minutes, step
# 51). Must be at least as frequent as the shortest configured per-connector interval to
# matter, so it defaults short.
KARPWIKI_CONNECTOR_DISPATCH_INTERVAL_MINUTES=5
# Git connector clone timeout, in seconds (connectors_git.py, step 54) — scales with the
# repos a deployment's connectors actually poll.
KARPWIKI_GIT_CLONE_TIMEOUT_SECONDS=60

# --- MCP server, stdio transport only (06 §2, phase2-tasklist.md step 45) ---
# stdio has no per-call HTTP headers, so identity resolves once at process startup from
# these instead — mirrors TrustedHeaderAuthenticator's X-Karpwiki-User/X-Karpwiki-Groups
# header names. Not read by streamable-HTTP mode, which uses real per-request headers.
KARPWIKI_MCP_USER=
KARPWIKI_MCP_GROUPS=
# A real bearer token (step 47) — takes precedence over KARPWIKI_MCP_USER when set, since
# a bare local stdio process can't run an interactive OIDC login to obtain one itself; only
# needed once KARPWIKI_OIDC_ISSUER/_AUDIENCE below are configured.
KARPWIKI_MCP_TOKEN=

# --- Real OIDC auth (06 §3, 08 §2's Authlib pick; phase2-tasklist.md step 47) ---
# Both empty by default — the gateway/MCP server keep using TrustedHeaderAuthenticator
# (09 §15's Phase 1 stand-in) until BOTH are set, then default_authenticator() swaps in a
# real bearer-JWT OidcAuthenticator with no handler changes. SAML is NOT supported —
# Authlib (the chosen library) has no SAML module at all; only OIDC is implemented.
KARPWIKI_OIDC_ISSUER=
KARPWIKI_OIDC_AUDIENCE=
# Optional — skips OIDC discovery (fetching {issuer}/.well-known/openid-configuration) when
# the IdP's JWKS endpoint isn't at the discovery document's default location.
KARPWIKI_OIDC_JWKS_URI=
# Which token claims carry the principal id and its groups — varies by IdP.
KARPWIKI_OIDC_PRINCIPAL_CLAIM=sub
KARPWIKI_OIDC_GROUPS_CLAIM=groups
# JWKS/discovery HTTP client timeout, in seconds.
KARPWIKI_OIDC_JWKS_TIMEOUT_SECONDS=5.0

# --- Rate limiting (01 §1-2, 07 §3, 09 §14; phase2-tasklist.md step 48) ---
# REST gateway only. One shared window; per-principal is always enforced (a coarse,
# unverified identity key), per-workspace only when workspace_id is already a plain
# request parameter. Defaults shown below.
KARPWIKI_RATE_LIMIT_WINDOW_SECONDS=60
KARPWIKI_RATE_LIMIT_SUBMIT_PER_PRINCIPAL=20
KARPWIKI_RATE_LIMIT_SUBMIT_PER_WORKSPACE=200
KARPWIKI_RATE_LIMIT_SEARCH_PER_PRINCIPAL=60
KARPWIKI_RATE_LIMIT_SEARCH_PER_WORKSPACE=600
KARPWIKI_RATE_LIMIT_GENERAL_PER_PRINCIPAL=300
KARPWIKI_RATE_LIMIT_GENERAL_PER_WORKSPACE=3000

# --- Taxonomy bulk-move (05 §7, 09 §11; phase2-tasklist.md step 27) ---
# Larger batches finish an admin's move faster but hold a longer-running transaction per
# batch.
KARPWIKI_BULK_MOVE_BATCH_SIZE=100

# --- Provider credential ---
# Standard name: the OpenAI SDK and Pydantic AI read it directly, so the
# Platform never handles the key itself. Not read by src/karpwiki/config.py.
OPENAI_API_KEY=
